# ==========================================
# ANTIMATTER ENVIRONMENT CONFIGURATION
# 100% Sovereign Offline Operation
# ==========================================

# Hardware Profile: edge (8GB), pro (16-24GB), workstation (48GB+), cpu_only
ANTIMATTER_PROFILE=pro

# LLM Backend: ollama | llama_cpp | vllm | mock
ANTIMATTER_LLM_BACKEND=ollama
ANTIMATTER_OLLAMA_BASE_URL=http://127.0.0.1:11434
ANTIMATTER_VLLM_BASE_URL=http://127.0.0.1:8000/v1

# Model Names (llama3.2:1b is pre-pulled in local Ollama; qwen2.5-coder is recommended for code generation)
ANTIMATTER_PLANNER_MODEL=llama3.2:1b
ANTIMATTER_AUTOCOMPLETE_MODEL=llama3.2:1b
ANTIMATTER_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Runtime & Sandbox Settings
ANTIMATTER_WORKSPACE_DIR=./workspace
ANTIMATTER_MAX_EXEC_TIMEOUT_SEC=120
ANTIMATTER_LOG_LEVEL=INFO

# Audio Engine (Optional)
ANTIMATTER_AUDIO_ENABLED=false
ANTIMATTER_WHISPER_MODEL=base.en
ANTIMATTER_PIPER_VOICE=en_US-lessac-medium
